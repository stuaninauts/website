---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';
import { getProjects } from '../lib/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const { projects, benchmarks } = await getProjects(lang);
---

<Base title={t('projects.title')}>
  <section class="wrap page">
    <Breadcrumb lang={lang} items={[{ label: t('nav.home'), href: localizePath('/', lang) }, { label: t('projects.title') }]} />
    <h1><span class="kj" aria-hidden="true">作品</span>{t('projects.title')}</h1>
    <p class="lead">{t('projects.lead')}</p>
    <div class="grid">{projects.map((project) => <ProjectCard project={project} lang={lang} />)}</div>
    <h2 class="sub" id="benchmarks">{t('work.benchmarks')}</h2>
    <div class="grid">{benchmarks.map((project) => <ProjectCard project={project} lang={lang} withMetrics />)}</div>
  </section>
</Base>

<style>
  .page { padding-top: clamp(28px, 5vw, 48px); }
  h1 { font-size: clamp(32px, 5vw, 44px); margin-top: 20px; }
  .lead { color: var(--ink-2); margin: 12px 0 36px; font-size: 18px; }
  .sub { font-size: 20px; margin: 56px 0 20px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
</style>
