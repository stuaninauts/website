---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Carousel from '../components/Carousel.astro';
import CoverPlaceholder from '../components/CoverPlaceholder.astro';
import Metrics from '../components/Metrics.astro';
import type { ProjectCategory } from '../data/project-order';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';
import { projectSlug, type Project } from '../lib/projects';

// Template da página (docs/decisions/0002): resultado e números no topo, gráfico-chave fixo no benchmark,
// telas em carrossel, corpo curto com ## seções e limitações em <details>, stack no fim.
interface Props { project: Project; lang: Lang; category: ProjectCategory; prev?: Project; next?: Project }
const { project, lang, category, prev, next } = Astro.props;
const t = useTranslations(lang);
const { title, summary, question, metrics, year, context, stack, repo, demo, writeup, cover, coverAlt, figure, gallery } = project.data;
const { Content } = await render(project);
const isBenchmark = category === 'benchmarks';
const projectsUrl = localizePath('/projects', lang);
const galleryLabel = isBenchmark ? t('project.charts') : t('project.screens');
const crumbs = [
  { label: t('nav.home'), href: localizePath('/', lang) },
  { label: t('projects.title'), href: projectsUrl },
  ...(isBenchmark ? [{ label: t('work.benchmarks'), href: `${projectsUrl}#benchmarks` }] : []),
  { label: title },
];
---

<Base title={title} description={summary}>
  <article class="wrap page">
    <Breadcrumb lang={lang} items={crumbs} />
    <header class="ph">
      <div>
        <h1>{title}</h1>
        {question && <p class="question"><span class="eyebrow">{t('project.question')}</span> {question}</p>}
        <p class="lead">{summary}</p>
        <p class="when mono">{year}{context && ` · ${context}`}</p>
        <p class="links">
          {repo && <a class="btn" href={repo}>{t('project.repo')} ↗</a>}
          {demo && <a class="btn primary" href={demo}>{t('project.demo')} ↗</a>}
          {writeup && <a class="btn" href={writeup}>{t('project.writeup')} ↗</a>}
        </p>
      </div>
      {cover ? (
        <Image src={cover} alt={coverAlt ?? ''} width={420} height={420} class="cover" loading="lazy" />
      ) : (
        <CoverPlaceholder title={title} class="cover" />
      )}
    </header>

    <Metrics items={metrics} label={t('project.metrics')} />

    {figure && (
      <figure class="key">
        <Image src={figure.src} alt={figure.alt} widths={[640, 960, 1280]} sizes="(max-width: 1080px) 100vw, 1016px" />
        <figcaption>{figure.caption}</figcaption>
      </figure>
    )}

    {!isBenchmark && gallery.length > 1 && <div class="block"><Carousel lang={lang} label={galleryLabel} items={gallery} /></div>}
    {!isBenchmark && gallery.length === 1 && (
      <figure class="key">
        <Image src={gallery[0].src} alt={gallery[0].alt} widths={[640, 960, 1280]} sizes="(max-width: 1080px) 100vw, 1016px" loading="lazy" />
        <figcaption>{gallery[0].caption}</figcaption>
      </figure>
    )}

    <div class="prose"><Content /></div>

    {isBenchmark && gallery.length > 0 && (
      <section class="block" aria-labelledby="more">
        <h2 id="more" class="eyebrow">{galleryLabel}</h2>
        {gallery.length > 1 ? (
          <Carousel lang={lang} label={galleryLabel} items={gallery} />
        ) : (
          <figure class="key">
            <Image src={gallery[0].src} alt={gallery[0].alt} widths={[640, 960, 1280]} sizes="(max-width: 1080px) 100vw, 1016px" loading="lazy" />
            <figcaption>{gallery[0].caption}</figcaption>
          </figure>
        )}
      </section>
    )}

    <section class="block stack" aria-labelledby="stack-title">
      <h2 id="stack-title" class="eyebrow">{t('project.stack')}</h2>
      <ul class="chips">{stack.map((s) => <li class="chip">{s}</li>)}</ul>
    </section>

    <nav class="pager" aria-label={t('projects.title')}>
      {prev ? <a class="prev" href={localizePath(`/projects/${projectSlug(prev)}`, lang)}><span class="eyebrow">← {t('project.prev')}</span>{prev.data.title}</a> : <span />}
      <a class="all" href={projectsUrl}>{t('project.back')}</a>
      {next ? <a class="next" href={localizePath(`/projects/${projectSlug(next)}`, lang)}><span class="eyebrow">{t('project.next')} →</span>{next.data.title}</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .page { padding-top: clamp(28px, 5vw, 48px); }
  .ph { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 40px; align-items: center; margin: 24px 0 40px; }
  h1 { font-size: clamp(34px, 5vw, 48px); }
  .question { margin-top: 14px; color: var(--ink-2); font-size: 17px; }
  .question .eyebrow { margin-right: 8px; }
  .lead { color: var(--ink); font-size: clamp(19px, 2.2vw, 22px); line-height: 1.45; margin: 14px 0 12px; max-width: 46ch; }
  .when { font-size: 13.5px; color: var(--muted); margin-bottom: 22px; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; }
  .ph :global(.cover) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; border: 1px solid var(--line); }
  .key { margin: 40px 0 0; }
  .key :global(img) { border: 1px solid var(--line); border-radius: 4px; background: #fff; }
  .key figcaption { font-size: 14px; color: var(--muted); margin-top: 10px; }
  .block { margin-top: 48px; }
  .block > h2 { margin-bottom: 14px; }
  .prose { max-width: 68ch; display: grid; gap: 16px; font-size: 16.5px; color: var(--ink-2); margin-top: 48px; }
  .prose :global(h2) { font-size: 19px; color: var(--ink); margin-top: 12px; }
  .prose :global(ul) { padding-left: 20px; display: grid; gap: 8px; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(details) { border-top: 1px solid var(--line); padding-top: 14px; }
  .prose :global(summary) { cursor: pointer; color: var(--ink); font-weight: 500; padding: 4px 0; }
  .prose :global(details[open] summary) { margin-bottom: 10px; }
  .prose :global(code) { font-family: var(--mono); font-size: .9em; background: var(--card-2); padding: 2px 6px; border-radius: 3px; }
  .pager { display: grid; grid-template-columns: 1fr auto 1fr; gap: 16px; align-items: center; margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--line); }
  .pager a { color: var(--ink); text-decoration: none; display: grid; gap: 4px; }
  .pager a:hover { color: var(--accent); }
  .pager .next { text-align: right; justify-self: end; }
  .pager .all { font-size: 14px; color: var(--muted); }
  @media (max-width: 760px) {
    .ph { grid-template-columns: 1fr; }
    .ph :global(.cover) { display: none; }
    .pager { grid-template-columns: 1fr 1fr; }
    .pager .all { grid-column: 1 / -1; grid-row: 2; text-align: center; }
  }
</style>
