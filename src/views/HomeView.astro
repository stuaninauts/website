---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Contact from '../components/Contact.astro';
import OrgMark from '../components/OrgMark.astro';
import portrait from '../assets/profile.jpg';
import { person, profile } from '../data/profile';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';
import { getProjects } from '../lib/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = profile[lang];
const { projects, benchmarks } = await getProjects(lang);
---

<Base>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="eyebrow">{t('hero.role')}</p>
      <h1>{person.name}</h1>
      <p class="lead">{t('hero.lead')}</p>
      <div class="cta">
        <a class="btn primary" href="#work">{t('hero.cta.work')}</a>
        <a class="btn" href="#contact">{t('hero.cta.contact')}</a>
      </div>
    </div>
    <figure class="hero-art">
      <svg class="enso" viewBox="0 0 200 200" aria-hidden="true">
        <path d="M100 14c48 0 86 37 86 85 0 49-39 87-87 87-47 0-85-38-85-86 0-40 26-71 63-82" />
      </svg>
      <Image src={portrait} alt={t('hero.photo')} width={360} height={360} class="portrait" loading="eager" fetchpriority="high" />
      <span class="seal stamp" aria-hidden="true" title={t('seal.title')}>宙</span>
    </figure>
  </section>

  <section class="section wrap" aria-labelledby="about">
    <SectionHeading kanji="紹介" title={t('about.title')} id="about" />
    <div class="about">
      <div class="prose">{p.about.map((para) => <p>{para}</p>)}</div>
      <div class="side">
        <ul class="chips">{p.focus.map((f) => <li class="chip">{f}</li>)}</ul>
        <aside class="card name" aria-labelledby="name-title">
          <p class="pal mono" aria-hidden="true">stuan<b>i</b>nauts</p>
          <h3 id="name-title">{t('name.title')}</h3>
          <p>{t('name.p1')}</p>
          <p>{t('name.p2')}</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="work">
    <SectionHeading kanji="作品" title={t('work.title')} id="work" />
    <div class="grid">{projects.map((project) => <ProjectCard project={project} lang={lang} />)}</div>
    <h3 class="sub" id="benchmarks">{t('work.benchmarks')}</h3>
    <div class="grid">{benchmarks.map((project) => <ProjectCard project={project} lang={lang} />)}</div>
    <p class="all"><a href={localizePath('/projects', lang)}>{t('work.all')} →</a></p>
  </section>

  <section class="section wrap" aria-labelledby="experience">
    <SectionHeading kanji="経歴" title={t('experience.title')} id="experience" />
    <ol class="timeline">
      {p.experience.map((job) => (
        <li class="job">
          <div class="job-h">
            <div class="org">
              <OrgMark org={job.org} logo={job.logo} />
              <h3>{job.org}</h3>
            </div>
            <p class="about-org">{job.about}</p>
            <p class="muted context">{job.context}</p>
          </div>
          <ol class="roles">
            {job.roles.map((role) => (
              <li>
                <p class="role"><strong>{role.title}</strong> <span class="mono muted">{role.period}</span></p>
                <ul>{role.points.map((pt) => <li>{pt}</li>)}</ul>
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
    <div class="edu">
      <div>
        <h3 class="eyebrow">{t('experience.education')}</h3>
        {p.education.map((e) => <p><strong>{e.title}</strong><br /><span class="muted">{e.detail} · <span class="mono">{e.period}</span></span></p>)}
      </div>
      <div>
        <h3 class="eyebrow">{t('experience.certs')}</h3>
        {p.certifications.map((c) => <p><strong>{c.title}</strong><br /><span class="muted">{c.detail} · <span class="mono">{c.period}</span></span></p>)}
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="stack">
    <SectionHeading kanji="道具" title={t('stack.title')} id="stack" />
    <div class="stack">
      {p.stack.map((g) => (
        <section aria-label={g.group}>
          <h3 class="eyebrow">{g.group}</h3>
          <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
        </section>
      ))}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="contact">
    <SectionHeading kanji="連絡" title={t('contact.title')} id="contact" />
    <p class="contact-lead">{t('contact.body')}</p>
    <Contact lang={lang} />
  </section>
</Base>

<style>
  /* ── Hero ── */
  .hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 72px); align-items: center; padding-top: clamp(48px, 9vw, 104px); }
  .hero h1 { font-size: clamp(40px, 7vw, 68px); letter-spacing: -.02em; margin: 14px 0 18px; }
  .lead { font-size: clamp(18px, 2.2vw, 21px); color: var(--ink-2); max-width: 34ch; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

  .hero-art { position: relative; margin: 0; justify-self: center; width: min(100%, 380px); aspect-ratio: 1; display: grid; place-items: center; }
  .portrait { width: 76%; aspect-ratio: 1; object-fit: cover; border-radius: 50%; filter: grayscale(.15) contrast(1.02); }
  .enso { position: absolute; inset: 0; width: 100%; height: 100%; }
  .enso path { fill: none; stroke: var(--ink); stroke-width: 5; stroke-linecap: round; opacity: .85;
    stroke-dasharray: 560; stroke-dashoffset: 560; animation: draw 1.6s var(--ease) .2s forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .stamp { --s: 54px; position: absolute; right: 6%; bottom: 8%; background: var(--paper); border-width: 2.5px;
    opacity: 0; transform: scale(1.4) rotate(-10deg); animation: stamp .35s var(--ease) 1.5s forwards; }
  @keyframes stamp { to { opacity: 1; transform: scale(1) rotate(-6deg); } }

  /* ── About ── */
  .about { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 40px; align-items: start; }
  .prose { display: grid; gap: 18px; color: var(--ink-2); font-size: 17px; }
  .prose p:first-child { color: var(--ink); }
  .side { display: grid; gap: 24px; }
  .name { display: grid; gap: 10px; font-size: 15px; color: var(--ink-2); }
  .name h3 { font-size: 17px; color: var(--ink); }
  .pal { font-size: 22px; letter-spacing: .12em; color: var(--ink); }
  .pal b { color: var(--seal); font-weight: 500; }

  /* ── Work ── */
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
  .sub { font-size: 18px; margin: 48px 0 20px; }
  .all { margin-top: 24px; }

  /* ── Experience ── */
  .timeline { list-style: none; padding: 0; margin: 0; display: grid; gap: 40px; }
  .job { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr); gap: 24px; }
  .org { display: flex; align-items: center; gap: 12px; }
  .org h3 { font-size: 20px; }
  .about-org { font-size: 14.5px; color: var(--ink-2); margin-top: 10px; }
  .context { font-size: 13.5px; margin-top: 6px; }
  .roles { list-style: none; padding: 0 0 0 24px; margin: 0; border-left: 1px solid var(--line-2); display: grid; gap: 24px; }
  .roles > li { position: relative; }
  .roles > li::before { content: ''; position: absolute; left: -29px; top: 9px; width: 9px; height: 9px; border-radius: 50%; background: var(--paper); border: 1.5px solid var(--seal); }
  .roles > li:first-child::before { background: var(--seal); }
  .role { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; margin-bottom: 8px; }
  .role .mono { font-size: 13px; }
  .roles ul { padding-left: 18px; color: var(--ink-2); display: grid; gap: 6px; font-size: 15.5px; }
  .roles ul li::marker { color: var(--muted); }
  .edu { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 48px; padding-top: 32px; border-top: 1px dashed var(--line-2); }
  .edu h3 { margin-bottom: 12px; }
  .edu p + p { margin-top: 12px; }

  /* ── Stack ── */
  .stack { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; }
  .stack section { border-top: 1px solid var(--line-2); padding-top: 14px; }
  .stack h3 { margin-bottom: 12px; }
  .stack ul { list-style: none; display: grid; gap: 7px; font-size: 15px; color: var(--ink-2); }

  /* ── Contact ── */
  .contact-lead { max-width: 60ch; color: var(--ink-2); font-size: 17px; margin-bottom: 24px; }

  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; }
    .hero-art { order: -1; width: min(70%, 280px); }
    .about, .job, .edu { grid-template-columns: 1fr; }
    .stack { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 24px; }
    .job { gap: 12px; }
  }
</style>
